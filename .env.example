# =============================================================
#  Chamar Garçom — variáveis de ambiente (OPCIONAIS)
#  O jeito mais simples é preencher src/config/firebase.config.js.
#  Se preferir variáveis, copie este arquivo para .env.local.
# =============================================================

# Configuração pública do Web App do Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Caminho do site. Local: /   GitHub Pages: /NOME-DO-REPOSITORIO/ (o workflow preenche sozinho)
VITE_BASE_PATH=/

# Endereço usado nos links e QR Codes das mesas.
# Ex.: para testar pelo celular na mesma rede: http://192.168.0.10:5173/
VITE_PUBLIC_APP_URL=

# true = usa os emuladores locais do Firebase (npm run emulators)
VITE_USE_EMULATORS=false
